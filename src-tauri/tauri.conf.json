{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roam Desktop",
  "version": "0.2.0",
  "identifier": "com.waris.roamdesktop",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "npm run build:adapter",
    "beforeDevCommand": "npm run build:adapter"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
