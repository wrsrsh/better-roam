{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "roam-window-controls",
  "description": "Only window controls are exposed to the Roam website.",
  "windows": ["main"],
  "remote": { "urls": ["https://roamresearch.com/*"] },
  "permissions": [
    "allow-hide-to-background",
    "core:window:allow-minimize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging"
  ]
}
